# 从 https://the-odds-api.com 获取 API Key（博彩公司数据源，可选）
# 支持多个 Key（逗号分隔），配额用完后自动轮换到下一个
# 例: ODDS_API_KEY=key1,key2,key3
ODDS_API_KEY=your_api_key_here

# 从 https://www.predictionhunt.com/api/docs 获取（预测市场聚合，可选）
PREDICTION_HUNT_API_KEY=your_prediction_hunt_key_here

# 总投注金额
TOTAL_STAKE=10000

# 最低理论收益率（%），0 表示仅由 MAX_ARB_INDEX 控制
MIN_PROFIT_PCT=0

# 套利指数上限（S < 此值才报警，默认 0.98 = 至少 2% 安全边际）
MAX_ARB_INDEX=0.98

# 循环扫描间隔（秒）；常规数据源约 3 分钟刷新时可设 180
SCAN_INTERVAL=180

# 飞书自定义机器人 Webhook（发现「新」套利机会时推送；与上次相同则不推）
# 创建方式: 飞书群 → 设置 → 群机器人 → 自定义机器人 → 复制 webhook 地址
FEISHU_WEBHOOK_URL=

# 飞书卡片模板 ID（在飞书开放平台 → 卡片构建器 创建模板后获取）
# 当前模板: AAqWdewlKr0Np
FEISHU_TEMPLATE_ID=

# 模拟盘初始资金
PAPER_BANKROLL=100000
